generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH MODELS (NextAuth) ====================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  settings      UserSettings?

  // Owned data
  recipes          Recipe[]
  mealPlans        MealPlan[]
  questionnaires   AIPQuestionnaire[]
  dailyLogs        AIPDailyLog[]
  symptomLogs      SymptomLog[]
  reintroTests     ReintroductionTest[]
  correlations     FoodSymptomCorrelation[]
  mealTemplates    MealTemplate[]
  favoriteFoods    FavoriteFood[]
  foodStatuses     UserFoodStatus[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AI config (BYOK)
  aiProvider AIProvider @default(NONE)
  llmBaseUrl String?
  llmApiKey  String?    // encrypted at rest
  llmModel   String?

  // AIP protocol
  aipVariant       AIPVariant @default(STANDARD)
  protocolStartDate DateTime?
  currentPhase     AIPPhase   @default(ELIMINATION)

  // UI
  darkMode Boolean @default(true)
  timezone String  @default("America/New_York")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== CORE DATA MODELS ====================

model Recipe {
  id            String         @id @default(uuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  ingredients   Json
  instructions  String
  prepTime      Int?
  cookTime      Int?
  servings      Int?
  tags          String[]
  source        String?
  imageUrl      String?
  isDraft       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mealPlanItems MealPlanItem[]
  aipMealEntries AIPMealEntry[]

  // Nutritional data (per serving)
  calories      Float?
  protein       Float?
  carbs         Float?
  fiber         Float?
  fat           Float?
  netCarbs      Float?

  // AIP compliance
  isAIPCompliant Boolean       @default(false)
}

model MealPlan {
  id            String         @id @default(uuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate DateTime       @db.Date
  status        MealPlanStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  groceryList   GroceryList?
  items         MealPlanItem[]
}

model MealPlanItem {
  id         String   @id @default(uuid())
  mealPlanId String
  recipeId   String
  date       DateTime @db.Date
  servings   Int      @default(1)  // Number of servings for grocery list scaling
  notes      String?
  createdAt  DateTime @default(now())
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id])
}

model GroceryList {
  id         String        @id @default(uuid())
  mealPlanId String        @unique
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      GroceryItem[]
  mealPlan   MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
}

model GroceryItem {
  id            String      @id @default(uuid())
  groceryListId String
  name          String
  quantity      String?
  unit          String?
  category      String      @default("Other")
  recipeNames   String[]    @default([])
  checked       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)

  // AIP quality preferences
  preferOrganic    Boolean  @default(false)
  preferNonGMO     Boolean  @default(false)
  preferGrassFed   Boolean  @default(false)
  preferWildCaught Boolean  @default(false)
  preferPasture    Boolean  @default(false)
  qualityNotes     String?  // e.g., "grass-fed", "wild-caught", "organic only"
  aipCompliant     Boolean  @default(true)
}

// ==================== AIP DIET MODELS ====================

model AIPQuestionnaire {
  id                String   @id @default(uuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String?

  // AIP Variant
  aipVariant        AIPVariant @default(STANDARD)
  diagnosisInfo     String?
  doctorRecommended Boolean    @default(false)
  experienceLevel   ExperienceLevel @default(BEGINNER)
  protocolStartDate DateTime?

  // Macro Targets
  dailyCalories     Int      @default(2000)
  dailyProtein      Int      @default(100)
  dailyNetCarbs     Int      @default(100)

  // Intermittent Fasting
  eatingWindowStart String   @default("11:30") // HH:MM format
  eatingWindowEnd   String   @default("18:30")

  // Meal Preferences
  includeSmoothie   Boolean  @default(true)
  smoothieTime      String?  @default("11:30")
  includeSnack      Boolean  @default(true)
  snackTime         String?  @default("18:30")

  // Morning Coffee
  includeMorningCoffee Boolean @default(true)
  morningCoffeeTime    String? @default("06:30")

  // Protein Preferences
  preferredProteins String[] @default([])

  // Health Goals
  healthGoals       String[] @default([])

  // Leftover Rules
  allowLeftovers    Boolean  @default(true)
  maxLeftoverHours  Int      @default(24)

  // Restrictions
  restrictions      AIPRestriction[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId])
}

model AIPRestriction {
  id              String             @id @default(uuid())
  questionnaireId String
  foodName        String
  restrictionType AIPRestrictionType
  severity        AIPSeverity        @default(MODERATE)
  notes           String?

  questionnaire   AIPQuestionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, foodName])
}

model AIPFood {
  id              String          @id @default(uuid())
  name            String          @unique
  category        AIPFoodCategory
  aipPhase        AIPPhase        @default(ELIMINATION)

  // Nutritional Data (per 100g)
  calories        Float           @default(0)
  protein         Float           @default(0)
  carbs           Float           @default(0)
  fiber           Float           @default(0)
  fat             Float           @default(0)
  netCarbs        Float           @default(0)

  // AIP-Specific
  tyramineLevel   TyramineLevel   @default(LOW)
  histamineLevel  HistamineLevel  @default(LOW)

  // Quality Markers
  preferOrganic    Boolean        @default(false)
  preferNonGMO     Boolean        @default(false)
  preferGrassFed   Boolean        @default(false)
  preferWildCaught Boolean        @default(false)
  preferPasture    Boolean        @default(false)

  // Nutrient density flags
  richInCalcium    Boolean        @default(false)
  richInB12        Boolean        @default(false)
  richInIron       Boolean        @default(false)
  richInZinc       Boolean        @default(false)
  richInIodine     Boolean        @default(false)
  richInSelenium   Boolean        @default(false)
  richInVitaminD   Boolean        @default(false)
  richInMagnesium  Boolean        @default(false)
  richInFolate     Boolean        @default(false)
  richInCholine    Boolean        @default(false)
  richInOmega3     Boolean        @default(false)

  // Modified AIP (2024)
  modifiedAIPAllowed Boolean      @default(false)

  // Education
  whyRestricted    String?        // "Nightshades contain solanine..."
  reintroStage     Int?           // 1-4
  reintroNotes     String?        // "Start with 1 tsp cooked egg yolk"

  // Serving Info
  servingSize      String?
  servingSizeGrams Float?

  createdAt        DateTime       @default(now())
}

// ==================== AIP DAILY TRACKING ====================

model AIPDailyLog {
  id        String         @id @default(uuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  meals     AIPMealEntry[]

  @@unique([userId, date])
}

model AIPMealEntry {
  id             String      @id @default(uuid())
  dailyLogId     String
  dailyLog       AIPDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  mealType       MealType
  mealName       String
  scheduledTime  String?     // HH:MM format
  servings       Float       @default(1)
  isLeftover     Boolean     @default(false)
  originalItemId String?     // Reference to original meal if leftover

  // Link to recipe for dynamic macros
  recipeId       String?
  recipe         Recipe?     @relation(fields: [recipeId], references: [id])

  // Macro tracking (fallback if no recipe linked)
  calories       Float?
  protein        Float?
  carbs          Float?
  fiber          Float?
  fat            Float?
  netCarbs       Float?

  // Meal tracking (for progress reports)
  eaten          Boolean     @default(false)
  skipped        Boolean     @default(false)
  eatenAt        DateTime?
  actualServings Float?      // If different from planned servings
  trackingNotes  String?     // Notes about the meal

  // Index for multi-item support (EXTRA_SNACKS can have multiple per day)
  itemIndex      Int         @default(0)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([dailyLogId, mealType, itemIndex])
}

// ==================== REINTRODUCTION PROTOCOL ====================

model ReintroductionTest {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodName        String
  foodCategory    String?
  reintroStage    Int             @default(1)  // 1-4
  status          ReintroStatus   @default(NOT_STARTED)

  // Test day (Day 0)
  testDate         DateTime?      @db.Date
  portion1Time     DateTime?
  portion1Amount   String?        // e.g. "1/2 tsp"
  portion2Time     DateTime?
  portion2Amount   String?
  portion3Time     DateTime?
  portion3Amount   String?

  // Observation period (Days 1-3)
  observationEndDate  DateTime?   @db.Date

  // Confirmation period (Days 4-7)
  confirmationStartDate DateTime? @db.Date
  confirmationEndDate   DateTime? @db.Date

  // Result
  result           ReintroResult?
  resultNotes      String?

  // Symptom snapshots (JSON: 7-day averages before/during/after)
  symptomsBefore   Json?
  symptomsDuring   Json?
  symptomsAfter    Json?

  reactions        ReintroReaction[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ReintroReaction {
  id          String   @id @default(uuid())
  testId      String
  test        ReintroductionTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  timestamp   DateTime @default(now())
  symptomType String   // e.g. "digestion", "headache", "skin"
  severity    Int      // 1-10
  notes       String?

  createdAt   DateTime @default(now())
}

// ==================== SYMPTOM TRACKING ====================

model SymptomLog {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  time      SymptomTime  // morning or evening

  // Core 8 symptoms (1-10 scale, higher = better, nullable)
  energy     Int?   // 1=exhausted, 10=energized
  pain       Int?   // 1=severe pain, 10=no pain
  digestion  Int?   // 1=severe issues, 10=perfect
  sleep      Int?   // 1=terrible, 10=great
  skin       Int?   // 1=severe flare, 10=clear
  mood       Int?   // 1=very low, 10=great
  brainFog   Int?   // 1=severe fog, 10=crystal clear
  headache   Int?   // 1=severe headache, 10=no headache

  // Optional extended tracking
  bristolScale    Int?   // 1-7 Bristol stool scale
  stressLevel     Int?   // 1-10
  exerciseMinutes Int?
  hydrationOz     Int?
  menstrualDay    Int?

  notes      String?
  tags       String[] @default([])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date, time])
}

// ==================== USER FOOD STATUS ====================

model UserFoodStatus {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodName   String
  status     FoodStatus     @default(UNKNOWN)
  notes      String?
  testedDate DateTime?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, foodName])
}

// ==================== QUICK LOGGING ====================

model MealTemplate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  mealType  MealType
  foods     Json     // Array of {name, calories, protein, carbs, fat}
  totalMacros Json?  // {calories, protein, carbs, fat, netCarbs}
  useCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model FavoriteFood {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodName      String
  defaultAmount String?  // e.g., "1 cup", "200g"
  macros        Json?    // {calories, protein, carbs, fat}
  useCount      Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, foodName])
}

// ==================== FOOD-SYMPTOM CORRELATION ====================

model FoodSymptomCorrelation {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodName       String
  symptomType    String   // matches SymptomLog fields: energy, pain, digestion, etc.
  correlation    Float    // -1.0 to 1.0 (negative = food worsens symptom, positive = food improves)
  sampleSize     Int      // number of days with data
  confidence     CorrelationConfidence @default(LOW)
  lastCalculated DateTime @default(now())

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, foodName, symptomType])
}

// ==================== ENUMS ====================

enum MealPlanStatus {
  DRAFT
  CONFIRMED
}

enum AIProvider {
  GEMINI
  OPENAI
  OPENROUTER
  OLLAMA
  NONE
}

enum AIPVariant {
  STANDARD
  MODIFIED_2024
}

enum ExperienceLevel {
  BEGINNER
  SOME_KNOWLEDGE
  EXPERIENCED
}

// AIP Enums
enum AIPRestrictionType {
  ALLERGY
  INTOLERANCE
  AVOID
  MIGRAINE_TRIGGER
  HIGH_TYRAMINE
  HIGH_HISTAMINE
}

enum AIPSeverity {
  MILD
  MODERATE
  SEVERE
}

enum AIPFoodCategory {
  MEAT_POULTRY
  MEAT_BEEF
  MEAT_PORK
  SEAFOOD
  VEGETABLE
  FRUIT
  FAT_OIL
  HERB_SPICE
  BROTH
  SMOOTHIE_INGREDIENT
  BEVERAGE
  OTHER
}

enum AIPPhase {
  ELIMINATION
  REINTRO_1
  REINTRO_2
  REINTRO_3
  REINTRO_4
  PERSONAL_AVOID
  SAFE
  AVOID
}

enum TyramineLevel {
  LOW
  MODERATE
  HIGH
}

enum HistamineLevel {
  LOW
  MODERATE
  HIGH
}

enum MealType {
  MORNING_COFFEE
  SMOOTHIE
  LUNCH
  AFTERNOON_SNACK
  DINNER
  EVENING_SNACK
  EXTRA_SNACKS
}

enum SymptomTime {
  MORNING
  EVENING
}

enum ReintroStatus {
  NOT_STARTED
  TESTING_DAY0
  OBSERVING
  CONFIRMING
  COMPLETE
  ABANDONED
}

enum ReintroResult {
  PASS
  FAIL
  INCONCLUSIVE
}

enum FoodStatus {
  SAFE
  AVOID
  TESTING
  UNKNOWN
}

enum CorrelationConfidence {
  LOW        // 5-9 data points
  MEDIUM     // 10-19 data points
  HIGH       // 20+ data points
}
