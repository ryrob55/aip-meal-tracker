# Database (required)
DATABASE_URL=postgresql://postgres:aip_password@localhost:5433/aip

# ==================== Authentication ====================

# NextAuth (required for hosted multi-user mode)
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth (optional — enables "Continue with Google" on login)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Magic Link (optional — enables passwordless email login)
# EMAIL_SERVER_HOST=smtp.example.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-email@example.com
# EMAIL_SERVER_PASSWORD=your-email-password
# EMAIL_FROM=AIP Tracker <noreply@example.com>

# ==================== Self-Hosted Mode ====================

# Set to "true" to skip authentication (single-user, self-hosted)
# When enabled, a default user is auto-created and all auth is bypassed
# SINGLE_USER_MODE=true

# ==================== LLM Configuration (optional) ====================
# Enables AI recipe generation and meal suggestions
# Works with any OpenAI-compatible API: OpenAI, Anthropic, Ollama, vLLM, etc.
# In multi-user mode, users configure their own AI keys via settings
# In single-user mode (or as fallback), these env vars are used:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
